{
  "expo": {
    "name": "DROP Rider",
    "slug": "drop-rider",
    "scheme": "drop-rider",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.drop.rider"
    },
    "android": {
      "package": "ng.drop.rider",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "DROP uses photos of you, your licence, and your Keke so passengers can confirm the ride.",
          "cameraPermission": "DROP uses the camera for your rider photo, your licence, and your Keke."
        }
      ]
    ]
  }
}
