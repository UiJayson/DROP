{
  "name": "drop",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:init": "node scripts/env-init.mjs",
    "db:up": "bash scripts/start-database.sh",
    "db:apply": "bash scripts/apply-database.sh",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --yes",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "supabase": "3.0.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
