# Copy this file with: pnpm env:init
# Leave the values blank until you have a Supabase project.
# Do not put real passwords in git.

# Shared project URL and public key. Safe to put in the apps.
# Leave these blank to open the screens. Phone sign-in starts working after you paste
# a development project's URL and anon key. Do not paste a production service role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never put this in a phone app or in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Optional error reporting. The apps start without these.
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Optional. Leave blank to use the Ikeja sample places and a straight-line fare estimate.
# When set, the passenger app searches with Google Places and prices the road distance
# with the Routes API. Enable Places API (New) and Routes API, and restrict the key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
